---
import BaseLayout from '../layouts/BaseLayout.astro'
import { HomePage } from '../views/HomePage'
import { HOME_FAQS } from '../data/faqs'
import { SEO, SITE_URL } from '../data/site'
import { faqPageJsonLd, productCoreJsonLd } from '../lib/seo'
---

<BaseLayout
  seo={SEO.home}
  jsonLdExtra={[productCoreJsonLd(), faqPageJsonLd(HOME_FAQS, `${SITE_URL}/`)]}
>
  <HomePage client:idle />
</BaseLayout>
